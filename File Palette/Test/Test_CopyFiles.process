<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns5="http://www.tibco.com/schemas/File Palette/Resources/Schemas/Service/File_Request" xmlns:pfx="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Common/Context" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Service/ParseRenderXMLCatalog_Request" xmlns:ns2="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Common//Header" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns4="http://www.tibco.com/schemas/File Palette/Resources/Schemas/Service/WriteFile_Request" xmlns:ns3="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Service/ParseRenderXMLNames_Request">
    <pd:name>Test/Test_CopyFiles.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startX>150</pd:startX>
    <pd:startY>64</pd:startY>
    <pd:returnBindings/>
    <pd:endName>End</pd:endName>
    <pd:endX>426</pd:endX>
    <pd:endY>64</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1756636894015</pd:targetNamespace>
    <pd:activity name="Call Process">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>262</pd:x>
        <pd:y>66</pd:y>
        <config>
            <processName>/Processes/Service/CopyFiles.process</processName>
        </config>
        <pd:inputBindings>
            <ns5:File_Request>
                <ns2:Header>
                    <pfx:Context>
                        <pfx:correlationId>
                            <xsl:value-of select="123"/>
                        </pfx:correlationId>
                    </pfx:Context>
                    <ns2:timestamp>
                        <xsl:value-of select="current-dateTime()"/>
                    </ns2:timestamp>
                </ns2:Header>
                <ns5:Body>
                    <ns5:sourcePath>
                        <xsl:value-of select="'C:\Users\marya\Desktop\TIBCO\File Palette\Resources\Files\Input\'"/>
                    </ns5:sourcePath>
                    <ns5:sourceFileName>
                        <xsl:value-of select="'*'"/>
                    </ns5:sourceFileName>
                    <ns5:message>
                        <xsl:value-of select="''"/>
                    </ns5:message>
                    <ns5:outputPath>
                        <xsl:value-of select="'C:\Users\marya\Desktop\TIBCO\File Palette\Resources\Files\Output\'"/>
                    </ns5:outputPath>
                    <ns5:outputFileName>
                        <xsl:value-of select="'Result.txt'"/>
                    </ns5:outputFileName>
                </ns5:Body>
            </ns5:File_Request>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Call Process</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Call Process</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>
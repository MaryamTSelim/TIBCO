<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pfx="http://www.tibco.com/schemas/File Palette/Resources/Schemas/Service/WriteFile_Request" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:pfx2="http://www.tibco.com/schemas/File Palette/Resources/Schemas/Service/File_Request" xmlns:ns="http://www.tibco.com/namespaces/tnt/plugins/file" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Common//Header">
    <xsd:import namespace="http://www.tibco.com/schemas/File Palette/Resources/Schemas/Service/WriteFile_Request" schemaLocation="/Resources/Schemas/Service/WriteFile_Request.xsd"/>
    <xsd:import namespace="http://www.tibco.com/schemas/File Palette/Resources/Schemas/Service/File_Request" schemaLocation="/Resources/Schemas/Service/File_Request.xsd"/>
    <pd:name>Processes/Service/CopyFiles.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startType ref="pfx2:File_Request"/>
    <pd:startX>136</pd:startX>
    <pd:startY>114</pd:startY>
    <pd:returnBindings/>
    <pd:endName>End</pd:endName>
    <pd:endX>766</pd:endX>
    <pd:endY>114</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1756680228806</pd:targetNamespace>
    <pd:activity name="List Files">
        <pd:type>com.tibco.plugin.file.ListFilesActivity</pd:type>
        <pd:resourceType>ae.activities.ListFilesActivity</pd:resourceType>
        <pd:x>240</pd:x>
        <pd:y>114</pd:y>
        <config>
            <mode>only-files</mode>
        </config>
        <pd:inputBindings>
            <ns:ListFilesActivityConfig>
                <fileName>
                    <xsl:value-of select="concat($Start/pfx2:File_Request/pfx2:Body/pfx2:sourcePath,$Start/pfx2:File_Request/pfx2:Body/pfx2:sourceFileName)"/>
                </fileName>
            </ns:ListFilesActivityConfig>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Map Data">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>351</pd:x>
        <pd:y>114</pd:y>
        <config>
            <element>
                <xsd:element name="files">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="fileInfo" minOccurs="0" maxOccurs="unbounded">
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="fullName" type="xsd:string"/>
                                        <xsd:element name="fileName" type="xsd:string"/>
                                    </xsd:sequence>
                                </xsd:complexType>
                            </xsd:element>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </element>
        </config>
        <pd:inputBindings>
            <files>
                <xsl:for-each select="$List-Files/ns:ListFilesActivityOutput/files/fileInfo[contains(fullName,'.txt')]">
                    <fileInfo>
                        <fullName>
                            <xsl:value-of select="fullName"/>
                        </fullName>
                        <fileName>
                            <xsl:value-of select="fileName"/>
                        </fileName>
                    </fileInfo>
                </xsl:for-each>
            </files>
        </pd:inputBindings>
    </pd:activity>
    <pd:group name="Group">
        <pd:type>com.tibco.pe.core.LoopGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:x>470</pd:x>
        <pd:y>21</pd:y>
        <pd:width>123</pd:width>
        <pd:height>173</pd:height>
        <pd:collapsedWidth>57</pd:collapsedWidth>
        <pd:collapsedHeight>70</pd:collapsedHeight>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>inputLoop</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:over>$Map-Data/files/fileInfo</pd:over>
            <pd:iterationElementSlot>fileInfo</pd:iterationElementSlot>
            <pd:indexSlot>index</pd:indexSlot>
            <pd:activityOutputName/>
            <pd:accumulateOutput>false</pd:accumulateOutput>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Copy File</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Copy File</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:activity name="Copy File">
            <pd:type>com.tibco.plugin.file.FileCopyActivity</pd:type>
            <pd:resourceType>ae.activities.FileCopyActivity</pd:resourceType>
            <pd:x>528</pd:x>
            <pd:y>95</pd:y>
            <config>
                <overwrite>true</overwrite>
                <createMissingDirectories>true</createMissingDirectories>
                <includeSubDirectories>true</includeSubDirectories>
            </config>
            <pd:inputBindings>
                <ns:CopyActivityConfig>
                    <fromFileName>
                        <xsl:value-of select="$fileInfo/fileInfo/fullName"/>
                    </fromFileName>
                    <toFileName>
                        <xsl:value-of select="concat($Start/pfx2:File_Request/pfx2:Body/pfx2:outputPath,$fileInfo/fileInfo/fileName)"/>
                    </toFileName>
                </ns:CopyActivityConfig>
            </pd:inputBindings>
        </pd:activity>
    </pd:group>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>List Files</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>List Files</pd:from>
        <pd:to>Map Data</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Map Data</pd:from>
        <pd:to>Group</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>
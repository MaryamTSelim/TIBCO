<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns:Catalog="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Model/Catalog"
	 xmlns:Course="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Model/Course"
	 targetNamespace="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Model/Catalog"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	<xs:import namespace="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Model/Course"/>
	<xs:element name="Catalog">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID" type="xs:int"/>
				<xs:element name="CenterName" type="xs:string"/>
				<xs:element name="ListOfCourses">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="Course:Course" maxOccurs="unbounded"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Address" type="xs:string"/>
				<xs:element name="Phone">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="11"/>
							<xs:maxLength value="11"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
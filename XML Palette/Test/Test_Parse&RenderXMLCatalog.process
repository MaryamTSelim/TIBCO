<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pfx="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Common/Context" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Service/ParseRenderXMLCatalog_Request" xmlns:ns2="http://www.tibco.com/schemas/XML Palette/Resources/Schemas/Common//Header">
    <pd:name>Test/Test_Parse&amp;RenderXMLCatalog.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startX>150</pd:startX>
    <pd:startY>64</pd:startY>
    <pd:returnBindings/>
    <pd:endName>End</pd:endName>
    <pd:endX>450</pd:endX>
    <pd:endY>64</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1756636894015</pd:targetNamespace>
    <pd:activity name="Parse&amp;RenderXMLCatalog">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>294</pd:x>
        <pd:y>64</pd:y>
        <config>
            <processName>/Processes/Service/Parse&amp;RenderXMLCatalog.process</processName>
        </config>
        <pd:inputBindings>
            <ns:ParseRenderXMLCatalog_Request>
                <ns2:Header>
                    <pfx:Context>
                        <pfx:correlationId>
                            <xsl:value-of select="123"/>
                        </pfx:correlationId>
                    </pfx:Context>
                    <ns2:timestamp>
                        <xsl:value-of select="current-dateTime()"/>
                    </ns2:timestamp>
                </ns2:Header>
                <ns:Body>
                    <ns:sourcePath>
                        <xsl:value-of select="'C:\Users\marya\Desktop\TIBCO\XML Palette\Resources\Files\'"/>
                    </ns:sourcePath>
                    <ns:sourceFileName>
                        <xsl:value-of select="'Catalog.xml'"/>
                    </ns:sourceFileName>
                </ns:Body>
            </ns:ParseRenderXMLCatalog_Request>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>Parse&amp;RenderXMLCatalog</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Parse&amp;RenderXMLCatalog</pd:from>
        <pd:to>End</pd:to>
        <pd:xpathDescription>C</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>